# npm start / npm run doctor read .env automatically (Node >= 22.9).
CODEX_TERMINAL_HOST=127.0.0.1
CODEX_TERMINAL_PORT=7681
# Set an absolute workspace path. Default: parent of the checkout directory.
# CODEX_TERMINAL_DEFAULT_CWD=/absolute/path/to/projects
# Optional overrides; otherwise executables are discovered from PATH.
# TMUX_PATH=/absolute/path/to/tmux
# CODEX_PATH=/absolute/path/to/codex
# Optional isolated tmux server; leave unset to see existing default sessions.
# CODEX_TERMINAL_TMUX_SOCKET=terminal-hub
CODEX_TERMINAL_EXCLUSIVE=1
CODEX_TERMINAL_BROKER_IDLE_MS=900000
CODEX_TERMINAL_HISTORY_CACHE_PAGES=10
# Save structure/directories; restore shells on an empty tmux server at startup.
CODEX_TERMINAL_WORKSPACE_SAVE=1
CODEX_TERMINAL_WORKSPACE_SAVE_MS=60000
# Default: .local/tmux-workspace.json (socket-specific when using -L).
# CODEX_TERMINAL_WORKSPACE_FILE=/absolute/private/path/tmux-workspace.json
